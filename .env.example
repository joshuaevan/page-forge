# PageForge environment variables
# Copy this to .env and fill in values as needed.
# All variables are optional — PageForge works with zero config.

# Local folder to watch for incoming PDFs
# PAGEFORGE_INBOX=/data/inbox

# Where processed images are saved
# PAGEFORGE_OUTPUT=/data/output

# Render DPI (higher = larger files, better quality). Default: 300
# PAGEFORGE_DPI=300

# Binarize threshold 0-255 (lower = more black). Default: 160
# PAGEFORGE_THRESHOLD=160

# Allow PDF uploads via the web UI. Default: true
# PAGEFORGE_ENABLE_UPLOAD=true

# How often (minutes) to poll the inbox and Drive. Default: 30
# SYNC_INTERVAL_MINUTES=30

# ── Google Drive (optional) ────────────────────────────────────────────────
# Set this to enable Drive sync. Also place credentials.json at /data/credentials.json.
# DRIVE_FOLDER_ID=your_folder_id_here
